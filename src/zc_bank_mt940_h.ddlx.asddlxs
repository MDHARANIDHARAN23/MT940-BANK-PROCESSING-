@Metadata.layer: #CORE

@UI.headerInfo: {
    typeName: 'Bank Statement',
    typeNamePlural: 'Bank Statements',
    title: {
        type: #STANDARD,
        value: 'StatementId'
    }
}

annotate entity ZC_BANK_MT940_H with
{
    @UI.facet: [
        {
            id: 'StatementInfo',
            purpose: #STANDARD,
            type: #IDENTIFICATION_REFERENCE,
            label: 'Statement Information',
            position: 10
        },
        {
            id: 'Transactions',
            purpose: #STANDARD,
            type: #LINEITEM_REFERENCE,
            label: 'Transactions',
            position: 20,
            targetElement: '_Transaction'
        }
    ]

    /* =========================
       STATEMENT ID
       ========================= */

    @UI.lineItem: [
        {
            position: 10,
            label: 'Statement ID',
            importance: #HIGH
        }
    ]
    @UI.identification: [
        {
            position: 10,
            label: 'Statement ID'
        }
    ]
    @UI.selectionField: [{ position: 10 }]
    StatementId;


    /* =========================
       BANK ACCOUNT
       ========================= */

    @UI.lineItem: [
        {
            position: 20,
            label: 'Bank Account',
            importance: #HIGH
        }
    ]
    @UI.identification: [
        {
            position: 20,
            label: 'Bank Account'
        }
    ]
    @UI.selectionField: [{ position: 20 }]
    BankAccount;


    /* =========================
       STATEMENT NO
       ========================= */

    @UI.lineItem: [
        {
            position: 30,
            label: 'Statement No',
            importance: #HIGH
        }
    ]
    @UI.identification: [
        {
            position: 30,
            label: 'Statement No'
        }
    ]
    StatementNo;


    /* =========================
       CURRENCY
       ========================= */

    @UI.lineItem: [
        {
            position: 40,
            label: 'Currency',
            importance: #MEDIUM
        }
    ]
