    /* =========================
       OPENING BALANCE
       ========================= */

    @UI.lineItem: [
        {
            position: 50,
            label: 'Opening Balance',
            importance: #MEDIUM
        }
    ]
    @UI.identification: [
        {
            position: 50,
            label: 'Opening Balance'
        }
    ]
    OpeningBalance;


    /* =========================
       STATEMENT DATE
       ========================= */

    @UI.lineItem: [
        {
            position: 60,
            label: 'Statement Date',
            importance: #HIGH
        }
    ]
    @UI.identification: [
        {
            position: 60,
            label: 'Statement Date'
        }
    ]
    @UI.selectionField: [{ position: 30 }]
    StatementDate;


    /* =========================
       CLOSING BALANCE
       ========================= */

    @UI.lineItem: [
        {
            position: 70,
            label: 'Closing Balance',
            importance: #MEDIUM
        }
    ]
