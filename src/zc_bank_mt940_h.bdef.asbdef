projection;
strict ( 2 );

define behavior for ZC_BANK_MT940_H alias BankStatement
{
  use create;
  use update;
  use delete;

  use association _Transaction { create; }
}

define behavior for ZC_BANK_MT940_I alias BankTransaction
{
  use update;
  use delete;

  use association _Header;
  use association _Reconciliation { create; }
}

define behavior for ZC_BANK_MT940_R alias Reconciliation
{
  use update;
  use delete;

  use association _Transaction;
  use association _Header;
}