    /* =========================
       NAME
       ========================= */

    @UI.lineItem: [
        {
            position: 100,
            importance: #HIGH,
            label: 'Name'
        }
    ]
    @UI.identification: [
        {
            position: 100,
            label: 'Name'
        }
